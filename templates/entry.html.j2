<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ entry.title or entry.title_en }} — {{ config.site_title }}</title>
  <link rel="stylesheet" href="../../static/style.css">
  <!-- OGP / Twitter Card -->
  {% set ns = namespace(og_venue='') %}
  {% if entry.type == 'journal' and entry.source and entry.source.journal_name %}{% set ns.og_venue = entry.source.journal_name %}
  {% elif entry.type == 'award' and entry.source and entry.source.award_name %}{% set ns.og_venue = entry.source.award_name %}
  {% elif entry.venue is defined and entry.venue %}{% set ns.og_venue = entry.venue %}
  {% elif entry.organization %}{% set ns.og_venue = entry.organization %}
  {% endif %}
  {% set og_title = entry.title or entry.title_en %}
  {% set og_authors = (entry.authors or []) | join(', ') %}
  {% set og_year = (entry.date | string)[:4] if entry.date else '' %}
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ og_title }}">
  {% if entry.abstract %}
  <meta property="og:description" content="{{ entry.abstract | truncate(200) }}">
  {% else %}
  <meta property="og:description" content="{{ og_authors }}{% if ns.og_venue %} — {{ ns.og_venue }}{% endif %}{% if og_year %} ({{ og_year }}){% endif %}">
  {% endif %}
  <meta property="og:site_name" content="{{ config.site_title }}">
  {% if config.base_url %}<meta property="og:url" content="{{ config.base_url }}/entries/{{ entry.id }}/">{% endif %}
  <meta name="twitter:card" content="summary">
  {% if config.base_url %}<link rel="alternate" type="application/atom+xml" title="{{ config.site_title }}" href="{{ config.base_url }}/feed.xml">{% endif %}
</head>
<body>
  <header>
    <h1><a href="../../">{{ config.site_title }}</a></h1>
    <div class="lang-toggle">
      <button class="lang-btn" data-lang="ja" onclick="applyLanguage('ja')">JA</button>
      <button class="lang-btn" data-lang="en" onclick="applyLanguage('en')">EN</button>
    </div>
  </header>

  <article class="entry-detail">
    <h2>
      {% if entry.title %}{{ entry.title }}{% endif %}
      {% if entry.title and entry.title_en %}<br>{% endif %}
      {% if entry.title_en %}<span class="title-en-large">{{ entry.title_en }}</span>{% endif %}
    </h2>

    <div class="badges">
      <div>
        <span class="badge badge-{{ entry.type }}" data-i18n-type="{{ entry.type }}">{{ entry.type }}</span>
        {% if entry.invited %}<span class="badge badge-invited" data-i18n="badge.invited.detail">招待講演</span>{% endif %}
        {% if entry.reviewed %}<span class="badge badge-reviewed" data-i18n="badge.reviewed.detail">査読あり</span>{% endif %}
        {% if entry.scope == 'international' %}<span class="badge badge-intl" data-i18n="badge.international">国際</span>{% endif %}
        {% if entry.scope == 'domestic' %}<span class="badge badge-dom" data-i18n="badge.domestic">国内</span>{% endif %}
      </div>
      {% if config.show_entry_id %}
      <code class="entry-id"><span data-i18n="detail.id">ID</span>: {{ entry.id }}</code>
      {% endif %}
    </div>

    <table class="detail-table">
      <tr>
        <th data-i18n="detail.authors">著者</th>
        <td>
          {% for a in entry._authors_hl %}
            {%- if a.highlight -%}
              {%- if a.style == 'bold' -%}
                <strong>{{ a.name }}</strong>
              {%- else -%}
                <span class="author-highlight">{{ a.name }}</span>
              {%- endif -%}
            {%- else -%}
              {{ a.name }}
            {%- endif -%}
            {%- if not loop.last %}, {% endif %}
          {% endfor %}
        </td>
      </tr>

      {% if entry.date %}
      <tr>
        <th data-i18n="detail.date">日付</th>
        <td>{{ entry.date }}</td>
      </tr>
      {% endif %}

      {% if entry.presenter %}
      <tr>
        <th data-i18n="detail.presenter">登壇者</th>
        <td>{{ entry.presenter }}</td>
      </tr>
      {% endif %}

      {% if entry.organization %}
      <tr>
        <th data-i18n="detail.organization">組織・学会</th>
        <td>{{ entry.organization }}</td>
      </tr>
      {% endif %}

      {% if entry.type == 'conference' %}
        {% if entry.venue %}
        <tr>
          <th data-i18n="detail.venue.conference">会議名</th>
          <td>{{ entry.venue }}{% if entry.venue_abbr %} ({{ entry.venue_abbr }}){% endif %}</td>
        </tr>
        {% endif %}
        {% if entry.location %}
        <tr><th data-i18n="detail.location">開催地</th><td>{{ entry.location }}</td></tr>
        {% endif %}
        {% if entry.source %}
          {% if entry.source.proceedings %}
          <tr><th data-i18n="detail.proceedings">論文集</th><td>{{ entry.source.proceedings }}</td></tr>
          {% endif %}
          {% if entry.source.pages %}
          <tr><th data-i18n="detail.pages">ページ</th><td>{{ entry.source.pages }}</td></tr>
          {% endif %}
        {% endif %}

      {% elif entry.type == 'journal' %}
        {% if entry.source %}
          {% if entry.source.journal_name %}
          <tr><th data-i18n="detail.journal">誌名</th><td>{{ entry.source.journal_name }}</td></tr>
          {% endif %}
          {% if entry.source.volume is defined %}
          <tr><th data-i18n="detail.vol_no">巻・号</th><td>Vol.{{ entry.source.volume }}{% if entry.source.number is defined %}, No.{{ entry.source.number }}{% endif %}</td></tr>
          {% endif %}
          {% if entry.source.pages %}
          <tr><th data-i18n="detail.pages">ページ</th><td>{{ entry.source.pages }}</td></tr>
          {% endif %}
          {% if entry.source.doi %}
          <tr><th data-i18n="detail.doi">DOI</th><td><a href="https://doi.org/{{ entry.source.doi }}">{{ entry.source.doi }}</a></td></tr>
          {% endif %}
        {% endif %}

      {% elif entry.type == 'talk' %}
        {% if entry.venue %}
        <tr><th data-i18n="detail.venue.talk">会場・イベント</th><td>{{ entry.venue }}</td></tr>
        {% endif %}
        {% if entry.location %}
        <tr><th data-i18n="detail.location">開催地</th><td>{{ entry.location }}</td></tr>
        {% endif %}
        {% if entry.source and entry.source.description %}
        <tr><th data-i18n="detail.note">備考</th><td>{{ entry.source.description }}</td></tr>
        {% endif %}

      {% elif entry.type == 'patent' %}
        {% if entry.source %}
          {% if entry.source.patent_number %}
          <tr><th data-i18n="detail.patent_number">特許番号</th><td>{{ entry.source.patent_number }}</td></tr>
          {% endif %}
          {% if entry.source.country %}
          <tr><th data-i18n="detail.country">国</th><td>{{ entry.source.country }}</td></tr>
          {% endif %}
          {% if entry.source.status %}
          <tr>
            <th data-i18n="detail.status">状態</th>
            <td data-i18n="{{ 'patent.granted' if entry.source.status == 'granted' else 'patent.applied' }}">{{ '登録' if entry.source.status == 'granted' else '出願' }}</td>
          </tr>
          {% endif %}
        {% endif %}

      {% elif entry.type == 'award' %}
        {% if entry.source %}
          {% if entry.source.award_name %}
          <tr><th data-i18n="detail.award_name">賞名</th><td>{{ entry.source.award_name }}</td></tr>
          {% endif %}
          {% if entry.source.org_giving_award %}
          <tr><th data-i18n="detail.org_giving_award">授与機関</th><td>{{ entry.source.org_giving_award }}</td></tr>
          {% endif %}
        {% endif %}

      {% elif entry.type == 'book' %}
        {% if entry.source %}
          {% if entry.source.publisher %}
          <tr><th data-i18n="detail.publisher">出版社</th><td>{{ entry.source.publisher }}</td></tr>
          {% endif %}
          {% if entry.source.isbn %}
          <tr><th data-i18n="detail.isbn">ISBN</th><td>{{ entry.source.isbn }}</td></tr>
          {% endif %}
          {% if entry.source.editors %}
          <tr><th data-i18n="detail.editors">編者</th><td>{{ entry.source.editors | join(', ') }}</td></tr>
          {% endif %}
          {% if entry.source.chapter %}
          <tr><th data-i18n="detail.chapter">章</th><td>{{ entry.source.chapter }}</td></tr>
          {% endif %}
          {% if entry.source.pages %}
          <tr><th data-i18n="detail.pages">ページ</th><td>{{ entry.source.pages }}</td></tr>
          {% endif %}
        {% endif %}

      {% elif entry.type == 'thesis' %}
        {% if entry.source %}
          {% if entry.source.institution %}
          <tr><th data-i18n="detail.institution">機関</th><td>{{ entry.source.institution }}</td></tr>
          {% endif %}
          {% if entry.source.degree %}
          {% set _deg = {'bachelor': '学士論文', 'master': '修士論文', 'doctoral': '博士論文'} %}
          <tr>
            <th data-i18n="detail.degree">学位</th>
            <td data-i18n="degree.{{ entry.source.degree }}">{{ _deg.get(entry.source.degree, entry.source.degree) }}</td>
          </tr>
          {% endif %}
        {% endif %}

      {% elif entry.type == 'report' %}
        {% if entry.source %}
          {% if entry.source.institution %}
          <tr><th data-i18n="detail.publisher_institution">発行機関</th><td>{{ entry.source.institution }}</td></tr>
          {% endif %}
          {% if entry.source.number %}
          <tr><th data-i18n="detail.report_number">レポート番号</th><td>{{ entry.source.number }}</td></tr>
          {% endif %}
        {% endif %}

      {% else %}
        {% if entry.source and entry.source.description %}
        <tr><th data-i18n="detail.source">出典</th><td>{{ entry.source.description }}</td></tr>
        {% endif %}
      {% endif %}

      {% if entry.url %}
      <tr>
        <th data-i18n="detail.url">URL / DOI</th>
        <td><a href="{{ entry.url }}">{{ entry.url }}</a></td>
      </tr>
      {% endif %}

      {% if entry.abstract %}
      <tr>
        <th data-i18n="detail.abstract">アブストラクト</th>
        <td class="abstract">{{ entry.abstract }}</td>
      </tr>
      {% endif %}

      {% if entry.note %}
      <tr>
        <th data-i18n="detail.note">備考</th>
        <td>{{ entry.note }}</td>
      </tr>
      {% endif %}
    </table>

    {% if entry.files %}
    <section class="files-section">
      <h3 data-i18n="section.files">添付ファイル</h3>
      <ul>
        {% for f in entry.files %}
        <li>
          {% if f.path %}
            <a href="../../{{ f.path }}">{{ f.label }}</a>
          {% elif f.url %}
            <a href="{{ f.url }}">{{ f.label }}</a>
          {% else %}
            {{ f.label }}
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    <section class="export-section">
      <h3 data-i18n="export.one.title">このエントリをエクスポート</h3>
      <button onclick="exportOne('yaml')">YAML</button>
      <button onclick="exportOne('json')">JSON</button>
      <button onclick="exportOne('bibtex')">BibTeX</button>
      <button onclick="exportOne('hayagriva')">Hayagriva</button>
      <button onclick="exportOne('ris')">RIS</button>
      <button onclick="exportOne('csl-json')">CSL-JSON</button>
    </section>

    <nav class="entry-nav">
      {% if prev_entry %}
      <a class="entry-nav-prev" href="../{{ prev_entry.id }}/" data-i18n="nav.prev">← 前の業績</a>
      {% else %}
      <span class="entry-nav-prev entry-nav-disabled"></span>
      {% endif %}
      {% if next_entry %}
      <a class="entry-nav-next" href="../{{ next_entry.id }}/" data-i18n="nav.next">次の業績 →</a>
      {% else %}
      <span class="entry-nav-next entry-nav-disabled"></span>
      {% endif %}
    </nav>
  </article>

  <footer>
    <p>Generated by <a href="https://github.com/mar-tusita/scholist">scholist</a> {{ scholist_version }}</p>
  </footer>

  <script>const SCHOLIST_DEFAULT_LANG = "{{ config.default_language or 'auto' }}";</script>
  <script src="../../static/i18n.js"></script>
  <script>
    const ENTRY = {{ entry | tojson }};
  </script>
  <script src="https://cdn.jsdelivr.net/npm/js-yaml@4/dist/js-yaml.min.js"></script>
  <script src="../../static/export.js"></script>
  <script>
    function exportOne(format) {
      exportEntries([ENTRY], format);
    }
    initLang();
  </script>
</body>
</html>
