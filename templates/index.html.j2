<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ config.site_title }}</title>
  <link rel="stylesheet" href="static/style.css">
  <!-- OGP / Twitter Card -->
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ config.site_title }}">
  <meta property="og:site_name" content="{{ config.site_title }}">
  {% if config.base_url %}<meta property="og:url" content="{{ config.base_url }}/">{% endif %}
  <meta name="twitter:card" content="summary">
</head>
<body>
  <header>
    <h1>{{ config.site_title }}</h1>
    <div class="lang-toggle">
      <button class="lang-btn" data-lang="ja" onclick="applyLanguage('ja')">JA</button>
      <button class="lang-btn" data-lang="en" onclick="applyLanguage('en')">EN</button>
    </div>
  </header>

  <div id="summary" class="summary"></div>

  <div class="controls">
    <div class="filters">
      <label><span data-i18n="filter.label.type">種別</span>:
        <select id="filter-type">
          <option value="" data-i18n="filter.all">すべて</option>
          <option value="conference" data-i18n="type.conference">会議</option>
          <option value="journal"    data-i18n="type.journal">論文誌</option>
          <option value="talk"       data-i18n="type.talk">講演</option>
          <option value="patent"     data-i18n="type.patent">特許</option>
          <option value="award"      data-i18n="type.award">受賞</option>
          <option value="book"       data-i18n="type.book">書籍</option>
          <option value="misc"       data-i18n="type.misc">解説等</option>
          <option value="thesis"     data-i18n="type.thesis">学位論文</option>
          <option value="report"     data-i18n="type.report">技術レポート</option>
          <option value="other"      data-i18n="type.other">その他</option>
        </select>
      </label>

      <label><span data-i18n="filter.label.year">年</span>:
        <select id="filter-year">
          <option value="" data-i18n="filter.all">すべて</option>
          {% set years = [] %}
          {% for e in entries %}
            {% if e.date %}
              {% set y = e.date[:4] %}
              {% if y not in years %}
                {% set _ = years.append(y) %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% for y in years | sort(reverse=True) %}
            <option value="{{ y }}">{{ y }}</option>
          {% endfor %}
        </select>
      </label>

      <label><span data-i18n="filter.label.scope">国内/国際</span>:
        <select id="filter-scope">
          <option value="" data-i18n="filter.all">すべて</option>
          <option value="domestic"      data-i18n="filter.domestic">国内</option>
          <option value="international" data-i18n="filter.international">国際</option>
        </select>
      </label>

      <label><span data-i18n="filter.label.reviewed">査読</span>:
        <select id="filter-reviewed">
          <option value="" data-i18n="filter.all">すべて</option>
          <option value="true"  data-i18n="filter.reviewed.yes">査読あり</option>
          <option value="false" data-i18n="filter.reviewed.no">査読なし</option>
        </select>
      </label>

      <label><span data-i18n="filter.label.invited">招待</span>:
        <select id="filter-invited">
          <option value="" data-i18n="filter.all">すべて</option>
          <option value="true"  data-i18n="filter.invited.yes">招待あり</option>
          <option value="false" data-i18n="filter.invited.no">招待なし</option>
        </select>
      </label>
    </div>

    <div class="search-box">
      <input type="search" id="search-input"
             placeholder="タイトル・著者・会議名で検索..."
             data-i18n-placeholder="search.placeholder">
    </div>

    <div class="export-all">
      <button onclick="exportAll('yaml')"      data-i18n="export.all.yaml">全件 YAML</button>
      <button onclick="exportAll('json')"      data-i18n="export.all.json">全件 JSON</button>
      <button onclick="exportAll('bibtex')"    data-i18n="export.all.bibtex">全件 BibTeX</button>
      <button onclick="exportAll('hayagriva')" data-i18n="export.all.hayagriva">全件 Hayagriva</button>
    </div>
  </div>

  <div id="count-display" class="count-display"></div>
  <div id="pagination-controls" class="pagination-controls" style="display:none">
    <button id="btn-show-more" onclick="showMore()" data-i18n="btn.show.more">さらに表示</button>
    <button id="btn-show-all"  onclick="showAll()"  data-i18n="btn.show.all">全件表示</button>
  </div>

  <table id="entries-table">
    <thead>
      <tr>
        <th data-i18n="col.year">年</th>
        <th data-i18n="col.type">種別</th>
        <th data-i18n="col.title">タイトル</th>
        <th data-i18n="col.authors">著者</th>
        <th data-i18n="col.venue">掲載先・会議</th>
      </tr>
    </thead>
    <tbody>
      {% for e in entries %}
      <tr class="entry-row"
          data-type="{{ e.type }}"
          data-year="{{ e.date[:4] if e.date else '' }}"
          data-scope="{{ e.scope if e.scope is defined else '' }}"
          data-reviewed="{{ 'true' if e.reviewed else 'false' }}"
          data-invited="{{ 'true' if e.invited else 'false' }}"
          data-searchtext="{{ ([e.title or '', e.title_en or '', e.abstract or ''] + (e.authors or []) + [e.venue or '', e.organization or '']) | join(' ') | lower }}">
        <td class="col-year">{{ e.date[:4] if e.date else '—' }}</td>
        <td class="col-type">
          <span class="badge badge-{{ e.type }}" data-i18n-type="{{ e.type }}">{{ e.type }}</span>
          {% if e.invited %}<span class="badge badge-invited" data-i18n="badge.invited">招待</span>{% endif %}
          {% if e.reviewed %}<span class="badge badge-reviewed" data-i18n="badge.reviewed">査読</span>{% endif %}
        </td>
        <td class="col-title">
          <a href="entries/{{ e.id }}/">{{ e.title or e.title_en }}</a>
          {% if e.title and e.title_en %}
            <span class="title-en">{{ e.title_en }}</span>
          {% endif %}
        </td>
        <td class="col-authors">
          {% for a in e._authors_hl %}
            {%- if a.highlight -%}
              {%- if a.style == 'bold' -%}
                <strong>{{ a.name }}</strong>
              {%- else -%}
                <span class="author-highlight">{{ a.name }}</span>
              {%- endif -%}
            {%- else -%}
              {{ a.name }}
            {%- endif -%}
            {%- if not loop.last %}, {% endif %}
          {% endfor %}
        </td>
        <td class="col-venue">
          {% if e.type == 'conference' %}{{ e.venue or '' }}
          {% elif e.type == 'journal' %}{{ e.source.journal_name if e.source else '' }}
          {% elif e.type == 'talk' %}{{ e.venue or '' }}
          {% elif e.type == 'award' %}{{ e.source.award_name if e.source else '' }}
          {% elif e.type == 'book' %}{{ e.source.publisher if e.source else '' }}
          {% elif e.type == 'thesis' %}{{ e.source.institution if e.source else '' }}
          {% elif e.type == 'report' %}{{ e.source.institution if e.source else '' }}
          {% else %}{{ e.source.description if e.source else '' }}
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <script>
    const SCHOLIST_DEFAULT_LANG = "{{ config.default_language or 'auto' }}";
    const SCHOLIST_PER_PAGE = {{ config.entries_per_page or 0 }};
  </script>
  <script src="static/i18n.js"></script>
  <script>
    const ALL_ENTRIES = {{ entries | tojson }};

    const TYPE_ORDER = ['conference', 'journal', 'talk', 'patent', 'award', 'book', 'thesis', 'report', 'misc', 'other'];
    const _counts = {};
    let _minYear = Infinity, _maxYear = -Infinity;
    ALL_ENTRIES.forEach(e => {
      _counts[e.type] = (_counts[e.type] || 0) + 1;
      if (e.date) {
        const y = parseInt(String(e.date).slice(0, 4));
        if (!isNaN(y)) { _minYear = Math.min(_minYear, y); _maxYear = Math.max(_maxYear, y); }
      }
    });
    const _total = ALL_ENTRIES.length;
    const _yearRange = _minYear <= _maxYear ? `${_minYear}–${_maxYear}` : '';

    function buildSummary() {
      const chips = TYPE_ORDER
        .filter(type => _counts[type])
        .map(type => `<span class="summary-chip summary-chip-${type}" data-i18n-type="${type}">${t('type.' + type)} <strong>${_counts[type]}</strong></span>`)
        .join('');
      document.getElementById('summary').innerHTML =
        `<span class="summary-meta">${t('summary.total', _total)}${_yearRange ? `&ensp;·&ensp;${_yearRange}` : ''}</span>`
        + `<span class="summary-chips">${chips}</span>`;
    }
    buildSummary();
  </script>
  <footer>
    <p>Generated by <a href="https://github.com/mar-tusita/scholist">scholist</a> {{ scholist_version }}</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/js-yaml@4/dist/js-yaml.min.js"></script>
  <script src="static/export.js"></script>
  <script>
    const rows = Array.from(document.querySelectorAll('.entry-row'));
    const countDisplay = document.getElementById('count-display');
    const paginationControls = document.getElementById('pagination-controls');
    let _lastShown = 0, _lastTotal = 0, _lastVisibleCount = 0;
    let _visibleLimit = SCHOLIST_PER_PAGE > 0 ? SCHOLIST_PER_PAGE : Infinity;

    function updateCount(shown, total) {
      _lastShown = shown; _lastTotal = total; _lastVisibleCount = shown;
      countDisplay.textContent = t('count', shown, total);
    }

    function _getFilteredRows() {
      const type     = document.getElementById('filter-type').value;
      const year     = document.getElementById('filter-year').value;
      const scope    = document.getElementById('filter-scope').value;
      const reviewed = document.getElementById('filter-reviewed').value;
      const invited  = document.getElementById('filter-invited').value;
      const query    = document.getElementById('search-input').value.toLowerCase();
      return rows.filter(row =>
        (!type     || row.dataset.type     === type)     &&
        (!year     || row.dataset.year     === year)     &&
        (!scope    || row.dataset.scope    === scope)    &&
        (!reviewed || row.dataset.reviewed === reviewed) &&
        (!invited  || row.dataset.invited  === invited)  &&
        (!query    || row.dataset.searchtext.includes(query))
      );
    }

    function _render() {
      const filtered = _getFilteredRows();
      const limit = _visibleLimit === Infinity ? filtered.length : Math.min(_visibleLimit, filtered.length);
      const filteredSet = new Set(filtered.slice(0, limit));
      rows.forEach(row => { row.style.display = filteredSet.has(row) ? '' : 'none'; });
      updateCount(limit, filtered.length);
      const hasMore = limit < filtered.length;
      paginationControls.style.display = hasMore ? '' : 'none';
    }

    function applyFilters() {
      _visibleLimit = SCHOLIST_PER_PAGE > 0 ? SCHOLIST_PER_PAGE : Infinity;
      _render();
      saveFiltersToUrl();
    }

    function showMore() {
      if (SCHOLIST_PER_PAGE > 0) _visibleLimit += SCHOLIST_PER_PAGE;
      else _visibleLimit = Infinity;
      _render();
    }

    function showAll() {
      _visibleLimit = Infinity;
      _render();
    }

    function saveFiltersToUrl() {
      const params = new URLSearchParams();
      const addIfSet = (id, key) => { const v = document.getElementById(id).value; if (v) params.set(key, v); };
      addIfSet('filter-type', 'type'); addIfSet('filter-year', 'year');
      addIfSet('filter-scope', 'scope'); addIfSet('filter-reviewed', 'reviewed');
      addIfSet('filter-invited', 'invited');
      const q = document.getElementById('search-input').value;
      if (q) params.set('q', q);
      const qs = params.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    function loadFiltersFromUrl() {
      const params = new URLSearchParams(location.search);
      const setVal = (id, key) => { const v = params.get(key); if (v !== null) document.getElementById(id).value = v; };
      setVal('filter-type', 'type'); setVal('filter-year', 'year');
      setVal('filter-scope', 'scope'); setVal('filter-reviewed', 'reviewed');
      setVal('filter-invited', 'invited');
      const q = params.get('q');
      if (q !== null) document.getElementById('search-input').value = q;
    }

    ['filter-type', 'filter-year', 'filter-scope', 'filter-reviewed', 'filter-invited'].forEach(id => {
      document.getElementById(id).addEventListener('change', applyFilters);
    });
    document.getElementById('search-input').addEventListener('input', applyFilters);

    loadFiltersFromUrl();
    applyFilters();
    initLang();
  </script>
</body>
</html>
